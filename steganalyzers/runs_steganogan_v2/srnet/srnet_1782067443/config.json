{
  "gpu": true,
  "network": "srnet",
  "srm_trainable": false,
  "tlu_threshold": 3.0,
  "abs_layer": true,
  "clamp_val": 3.0,
  "ca_reduction": 8,
  "dropout": 0.5,
  "freeze_backbone": false,
  "epochs": 100,
  "batch_size": 32,
  "num_workers": 4,
  "lr": 0.01,
  "momentum": 0.9,
  "nesterov": true,
  "weight_decay": 1e-05,
  "scheduler": "plateau",
  "lr_min": 1e-06,
  "lr_patience": 5,
  "dataset": "steganogan",
  "data_root": "/workspace/steganogan-dataset-v2",
  "crop_size": 512,
  "stego_algs": [
    "basic",
    "dense",
    "residual"
  ],
  "val_frac": 0.1,
  "test_frac": 0.1,
  "balanced": true,
  "max_samples": null,
  "monitor": "auc_roc"
}